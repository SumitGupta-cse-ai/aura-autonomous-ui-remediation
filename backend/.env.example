# AURA Backend Environment Variables
# Copy this to .env and fill in your values

# OpenAI API Key (required for AI analysis, vision, and fix planning)
OPENAI_API_KEY=your-openai-api-key-here

# Server host & port
HOST=0.0.0.0
PORT=8000

# Production URLs & CORS
FRONTEND_URL=https://aura-autonomous-ui-remediation-oullh9ar2-cubic-closure.vercel.app
RENDER_EXTERNAL_URL=https://aura-autonomous-ui-remediation.onrender.com

# Allow local demo scanning (true allows scanning local demo pages and offline environments)
AURA_ALLOW_LOCAL=true

# Environment (development or production)
ENV=production
